{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "DataX.now",
    "defaultKernelName": "xpython",
    "exposeAppInBrowser": true,
    "enableServiceWorkerCache": true,
    "xeusStartupProfile": "balanced",
    "xeusBackgroundWarm": "js",
    "xeusInitMainKernelWarm": "none",
    "xeusKernelPoolEnabled": true,
    "xeusKernelPoolMax": 100,
    "xeusKernelPoolWarm": 2,
    "xeusKernelPoolTimeout": 300000,
    "xeusAutoPrewarm": true,
    "xeusPrewarmDelay": 0,
    "appUrl": "./lab",
    "settingsOverrides": {
      "@jupyterlab/notebook-extension:tracker": {
        "autoStartDefaultKernel": true,
        "autoRenderMarkdownCells": false
      },
      "@jupyterlab/toc-extension:registry": {
        "includeOutput": false
      },
      "datax-now-front:plugin": {
        "startupNotebook": "00_agent_features.ipynb"
      }
    }
  }
}
